# AI 模型配置（第一版使用 DeepSeek）
# 复制此文件为 .env 并填入真实 API Key
API_KEY=your-deepseek-api-key-here
BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 后续可切换为其他国产模型（均兼容 OpenAI API 格式）：
